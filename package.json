{
  "name": "growth-island",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Growth Island — a networking game. Production Phaser 3 + Vite build.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run server\" \"vite\"",
    "dev:web": "vite",
    "server": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.4",
    "typescript": "~5.8.0",
    "vite": "^6.3.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "phaser": "^3.88.2",
    "uuid": "^14.0.1",
    "ws": "^8.21.2"
  }
}
