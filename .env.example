# Optional Stripe Payment Links (client-side only — never put secret keys here)
VITE_STRIPE_MASTERCLASS=
VITE_STRIPE_MASTERCLASS_CONSULT=
VITE_STRIPE_AI_WORKSHOP=

# Public app version stamp
VITE_APP_VERSION=1.0.0

# API (leave empty in dev — Vite proxies /api and /ws to :8787)
# VITE_API_BASE=https://your-api.example.com
# VITE_WS_URL=wss://your-api.example.com/ws

# Server
PORT=8787
JWT_SECRET=change-me-in-production
