# ===== Server (Railway / Node) =====
PORT=8080
NODE_ENV=production
# REQUIRED in production (>=24 chars, not the default)
JWT_SECRET=replace-with-long-random-string
# Optional durable data path (attach Railway volume here)
DATA_DIR=/app/data
# Comma-separated browser origins allowed in prod (empty = same-host only)
CORS_ORIGINS=
# Admin panel at /admin.html
ADMIN_KEY=replace-with-admin-key

# ===== Client (Vite build-time) =====
VITE_APP_VERSION=1.0.0
# Stripe Payment Links — paste from Stripe Dashboard → Payment Links
VITE_STRIPE_MASTERCLASS=
VITE_STRIPE_MASTERCLASS_CONSULT=
VITE_STRIPE_AI_WORKSHOP=
# Optional Sentry DSN (errors also flow to /api/analytics)
VITE_SENTRY_DSN=
# Leave empty when API is same origin (Railway single service)
# VITE_API_BASE=
# VITE_WS_URL=
